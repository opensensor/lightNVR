{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectDedicatedArchiveBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning", "s3:GetLifecycleConfiguration", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET"
    },
    {
      "Sid": "ManageOnlyThisInstancePrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_INSTANCE_PREFIX/*"
    }
  ]
}
