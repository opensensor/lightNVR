      "fingerprint_scheme": "sca",
      "tool": "npm audit"
    },
    {
      "id": "dependabot",
      "report_format": "json (REST repos/{repo}/dependabot/alerts)",
      "access_status": "accessible",
      "report_path_convention": "build/eng-artifacts/<task>/github/dependabot-open.json",
      "fingerprint_scheme": "sca",
      "tool": "GitHub Dependabot alerts"
    }
  ]
