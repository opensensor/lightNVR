  "operations": {
    "listStreams": {
      "method": "GET",
      "path": "/api/streams",
      "success_statuses": [
        200
      ],
      "responses": {
        "200": {
          "description": "Summary page (surface-specific) or legacy array.",
          "headers": {
            "Cache-Control": {
              "$ref": "#/components/headers/CacheControl"
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/StreamSummaryPageAdmin"
                  },
                  {
                    "$ref": "#/components/schemas/StreamSummaryPageLive"
                  },
                  {
                    "$ref": "#/components/schemas/StreamSummaryPageLpr"
                  },
                  {
                    "$ref": "#/components/schemas/LegacyStreamList"
                  }
                ]
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "description": "Includes \"Authorization policy evaluation failed\", which is also returned for the WHOLE list when any stream lacks a fleet inventory row (finding candidate F-T11-10).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        }
      },
      "variant_by_query": {
        "parameter": "surface",
        "requires": {
          "summary": [
            "true",
            "1"
          ]
        },
        "mapping": {
          "admin": "#/components/schemas/StreamSummaryPageAdmin",
          "live": "#/components/schemas/StreamSummaryPageLive",
          "lpr": "#/components/schemas/StreamSummaryPageLpr"
        },
        "otherwise": "#/components/schemas/LegacyStreamList"
      }
    },
    "getStreamFull": {
      "method": "GET",
      "path": "/api/streams/{name}/full",
      "success_statuses": [
        200
      ],
      "responses": {
        "200": {
          "description": "Stream detail, configure or live-only variant.",
          "headers": {
            "Cache-Control": {
              "$ref": "#/components/headers/CacheControl"
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamFullResponse"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/StreamNotFound"
        },
        "500": {
          "$ref": "#/components/responses/InternalError"
        }
      },
      "variant_by_field": {
        "field": "stream.can_control_privacy",
        "mapping": {
          "true": "#/components/schemas/StreamFullResponseConfigurable",
          "false": "#/components/schemas/StreamFullResponseLiveOnly"
        }
      }
    },
    "updateStream": {
      "method": "PUT",
      "path": "/api/streams/{name}",
      "success_statuses": [
        200,
        202
      ],
      "responses": {
        "200": {
          "description": "set_privacy_mode short-circuit result.",
          "headers": {
            "Cache-Control": {
              "$ref": "#/components/headers/CacheControl"
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamPrivacyModeResponse"
              }
            }
          }
        },
        "202": {
          "description": "Update accepted; applied asynchronously by a worker thread.",
          "headers": {
            "Cache-Control": {
              "$ref": "#/components/headers/CacheControl"
            }
          },
          "content": {
            "application/json": {
