# CI suite membership lives beside each test registration. For example:
#   add_layer2_test(test_example CI_UNIT CI_SANITIZER)
# Both the aggregate build target and CTest label come from that declaration.
add_custom_target(ci-unit-tests)
add_custom_target(ci-sanitizer-tests)

function(lightnvr_ci_test TEST_TARGET)
    cmake_parse_arguments(ARG "CI_UNIT;CI_SANITIZER" "" "TESTS" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown CI test options: ${ARG_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT TARGET ${TEST_TARGET})
        message(FATAL_ERROR "Missing CI test target: ${TEST_TARGET}")
    endif()
    if(NOT ARG_TESTS)
        set(ARG_TESTS ${TEST_TARGET})
    endif()
    foreach(SUITE IN ITEMS UNIT SANITIZER)
        if(ARG_CI_${SUITE})
            string(TOLOWER "${SUITE}" SUITE_LABEL)
            add_dependencies(ci-${SUITE_LABEL}-tests ${TEST_TARGET})
            foreach(TEST_NAME IN LISTS ARG_TESTS)
                if(NOT TEST ${TEST_NAME})
                    message(FATAL_ERROR "Missing CI test registration: ${TEST_NAME}")
                endif()
                set_property(TEST ${TEST_NAME} APPEND PROPERTY LABELS ci-${SUITE_LABEL})
            endforeach()
        endif()
    endforeach()
endfunction()
