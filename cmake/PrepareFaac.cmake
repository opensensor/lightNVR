# Standalone preparation: intentionally uses only CMake 3.10 and Git.
cmake_minimum_required(VERSION 3.10)
function(faac_fail text)
    if(DEFINED FAAC_STAGE AND IS_DIRECTORY "${FAAC_STAGE}" AND NOT IS_SYMLINK "${FAAC_STAGE}")
        file(REMOVE_RECURSE "${FAAC_STAGE}")
    endif()
    message(FATAL_ERROR "FAAC preparation: ${text}")
endfunction()
function(no_symlinks path)
    get_filename_component(cursor "${path}" ABSOLUTE)
    while(NOT cursor STREQUAL "")
        if(IS_SYMLINK "${cursor}")
            faac_fail("symlink refused: ${cursor}")
        endif()
        get_filename_component(parent "${cursor}" DIRECTORY)
        if(parent STREQUAL cursor)
            break()
        endif()
        set(cursor "${parent}")
    endwhile()
endfunction()
function(record_parts record path_var hash_var)
    string(REPLACE "|" ";" parts "${record}")
    list(LENGTH parts count)
    if(NOT count EQUAL 2)
        faac_fail("invalid hash record")
    endif()
    list(GET parts 0 path)
    list(GET parts 1 digest)
    if(NOT path MATCHES "^((libfaac|include)/[A-Za-z0-9_./-]+|COPYING)$" OR
       path MATCHES "(^|/)\.\.(/|$)" OR path MATCHES "//")
        faac_fail("unsafe path: ${path}")
    endif()
    string(LENGTH "${digest}" length)
    if(NOT length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
        faac_fail("invalid hash for ${path}")
    endif()
    set(${path_var} "${path}" PARENT_SCOPE)
    set(${hash_var} "${digest}" PARENT_SCOPE)
endfunction()
function(inventory root expected label)
    no_symlinks("${root}")
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${root}"
        "${root}/libfaac/*" "${root}/include/*")
    set(actual "COPYING")
    foreach(path IN LISTS entries)
        no_symlinks("${root}/${path}")
        if(NOT IS_DIRECTORY "${root}/${path}")
            list(APPEND actual "${path}")
        endif()
    endforeach()
    list(SORT actual)
    set(sorted_expected "${expected}")
    list(SORT sorted_expected)
    if(NOT actual STREQUAL sorted_expected)
        faac_fail("${label} inventory mismatch")
    endif()
endfunction()
function(check_hashes root records label)
    foreach(record IN LISTS records)
        record_parts("${record}" path digest)
        no_symlinks("${root}/${path}")
        if(NOT EXISTS "${root}/${path}" OR IS_DIRECTORY "${root}/${path}")
            faac_fail("${label} inventory missing ${path}")
        endif()
        file(SHA256 "${root}/${path}" actual)
        if(NOT actual STREQUAL digest)
            faac_fail("${label} hash mismatch: ${path}")
        endif()
    endforeach()
endfunction()
function(json_escape value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
foreach(required FAAC_UPSTREAM_DIR FAAC_BUILD_DIR FAAC_PATCH_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        faac_fail("missing ${required}")
    endif()
    get_filename_component(${required} "${${required}}" ABSOLUTE)
    no_symlinks("${${required}}")
endforeach()
# Neither source nor destination may contain the other.
string(FIND "${FAAC_BUILD_DIR}/" "${FAAC_UPSTREAM_DIR}/" nested_output)
string(FIND "${FAAC_UPSTREAM_DIR}/" "${FAAC_BUILD_DIR}/" nested_source)
if(nested_output EQUAL 0 OR nested_source EQUAL 0)
    faac_fail("source/output overlap")
endif()
no_symlinks("${FAAC_PATCH_DIR}/manifest.cmake")
no_symlinks("${FAAC_PATCH_DIR}/manifest.json")
include("${FAAC_PATCH_DIR}/manifest.cmake")
file(SHA256 "${FAAC_PATCH_DIR}/manifest.json" actual_manifest)
if(NOT actual_manifest STREQUAL FAAC_MANIFEST_SHA256)
    faac_fail("manifest hash mismatch")
endif()
set(patch "${FAAC_PATCH_DIR}/0001-bound-input-pointer-arithmetic.patch")
no_symlinks("${patch}")
file(SHA256 "${patch}" actual_patch)
if(NOT actual_patch STREQUAL FAAC_PATCH_SHA256)
    faac_fail("patch hash mismatch")
endif()
find_package(Git REQUIRED)
# This process must not inherit another checkout's Git index/worktree.
unset(ENV{GIT_DIR})
unset(ENV{GIT_WORK_TREE})
unset(ENV{GIT_INDEX_FILE})
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${FAAC_UPSTREAM_DIR}" rev-parse HEAD
    RESULT_VARIABLE result OUTPUT_VARIABLE actual_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT result EQUAL 0 OR NOT actual_commit STREQUAL FAAC_UPSTREAM_COMMIT)
    faac_fail("upstream commit mismatch")
endif()
if(DEFINED FAAC_SUPERPROJECT_DIR)
    no_symlinks("${FAAC_SUPERPROJECT_DIR}")
    file(RELATIVE_PATH gitlink_path "${FAAC_SUPERPROJECT_DIR}" "${FAAC_UPSTREAM_DIR}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${FAAC_SUPERPROJECT_DIR}"
        ls-files --stage -- "${gitlink_path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE gitlink OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(expected_gitlink "160000 ${FAAC_UPSTREAM_COMMIT} 0\t${gitlink_path}")
    if(NOT result EQUAL 0 OR NOT gitlink STREQUAL expected_gitlink)
        faac_fail("superproject gitlink mismatch")
    endif()
endif()
set(input_paths "")
foreach(record IN LISTS FAAC_INPUT_RECORDS)
    record_parts("${record}" path digest)
    if(path IN_LIST input_paths)
        faac_fail("duplicate input path")
    endif()
    list(APPEND input_paths "${path}")
    set("input_${path}" "${digest}")
endforeach()
set(output_paths "")
foreach(record IN LISTS FAAC_OUTPUT_RECORDS)
    record_parts("${record}" path digest)
    list(APPEND output_paths "${path}")
    set("output_${path}" "${digest}")
endforeach()
if(NOT input_paths STREQUAL output_paths)
    faac_fail("input/output inventory mismatch")
endif()
set(checked_units "")
foreach(unit IN LISTS FAAC_TRANSLATION_UNITS)
    if(NOT unit IN_LIST input_paths OR NOT unit MATCHES "\\.c$" OR unit IN_LIST checked_units)
        faac_fail("invalid translation unit inventory")
    endif()
    list(APPEND checked_units "${unit}")
endforeach()
if(NOT checked_units)
    faac_fail("empty translation unit inventory")
endif()
inventory("${FAAC_UPSTREAM_DIR}" "${input_paths}" "input")
check_hashes("${FAAC_UPSTREAM_DIR}" "${FAAC_INPUT_RECORDS}" "input")
# Only these private implementation files may be changed by the diff. Git's
# numstat parses actual diff paths; reject additions/deletions/renames via the
# fixed input/output inventory and postimage hashes as well.
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${FAAC_UPSTREAM_DIR}" apply --numstat "${patch}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stats ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    faac_fail("patch path parse failed: ${error}")
endif()
string(REPLACE "\n" ";" lines "${stats}")
set(changed "")
foreach(line IN LISTS lines)
    if(line STREQUAL "")
        continue()
    endif()
    if(NOT line MATCHES "^[0-9]+\t[0-9]+\t(libfaac/(frame.c|faac.c|faac_internal.h))$")
        faac_fail("patch path outside allowed scope: ${line}")
    endif()
    list(APPEND changed "${CMAKE_MATCH_1}")
endforeach()
if(NOT changed)
    faac_fail("patch path list is empty")
endif()
json_escape("${FAAC_UPSTREAM_DIR}" source_json)
json_escape("${FAAC_BUILD_DIR}" build_json)
json_escape("${FAAC_COMPILER}" compiler_json)
json_escape("${FAAC_BUILD_PROFILE}" profile_json)
set(provenance "{\n  \"schema_version\": 1,\n  \"upstream_commit\": \"${FAAC_UPSTREAM_COMMIT}\",\n  \"patch_sha256\": \"${FAAC_PATCH_SHA256}\",\n  \"manifest_sha256\": \"${FAAC_MANIFEST_SHA256}\",\n  \"source_root\": \"${source_json}\",\n  \"build_root\": \"${build_json}\",\n  \"compiler\": \"${compiler_json}\",\n  \"build_profile\": \"${profile_json}\",\n  \"files\": [")
set(separator "")
set(units "")
set(unit_separator "")
foreach(path IN LISTS input_paths)
    json_escape("${FAAC_BUILD_DIR}/${path}" compiled_json)
    string(APPEND provenance "${separator}\n    {\"upstream_path\":\"${path}\",\"input_sha256\":\"${input_${path}}\",\"output_sha256\":\"${output_${path}}\",\"compiled_path\":\"${compiled_json}\"}")
    set(separator ",")
    if(path IN_LIST FAAC_TRANSLATION_UNITS)
        string(APPEND units "${unit_separator}\n    \"${compiled_json}\"")
        set(unit_separator ",")
    endif()
endforeach()
string(APPEND provenance "\n  ],\n  \"translation_units\": [${units}\n  ]\n}\n")
if(EXISTS "${FAAC_BUILD_DIR}")
    inventory("${FAAC_BUILD_DIR}" "${output_paths}" "output")
    check_hashes("${FAAC_BUILD_DIR}" "${FAAC_OUTPUT_RECORDS}" "output")
    no_symlinks("${FAAC_BUILD_DIR}/provenance.json")
    if(NOT EXISTS "${FAAC_BUILD_DIR}/provenance.json")
        faac_fail("missing output provenance; use a fresh owned build directory")
    endif()
    file(READ "${FAAC_BUILD_DIR}/provenance.json" existing)
    if(NOT existing STREQUAL provenance)
        faac_fail("output provenance mismatch; use a fresh owned build directory")
    endif()
    return()
endif()
get_filename_component(parent "${FAAC_BUILD_DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(FAAC_STAGE "${parent}/.faac-stage-${token}")
if(EXISTS "${FAAC_STAGE}" OR IS_SYMLINK "${FAAC_STAGE}")
    faac_fail("staging collision")
endif()
file(MAKE_DIRECTORY "${FAAC_STAGE}")
foreach(path IN LISTS input_paths)
    get_filename_component(dir "${FAAC_STAGE}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    configure_file("${FAAC_UPSTREAM_DIR}/${path}" "${FAAC_STAGE}/${path}" COPYONLY)
endforeach()
# Stop Git discovery at the stage parent: apply to files, never the workspace
# index or a submodule. Git metadata is neither created nor copied here.
set(ENV{GIT_CEILING_DIRECTORIES} "${parent}")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${FAAC_STAGE}" apply --check "${patch}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    faac_fail("patch check failed: ${error}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${FAAC_STAGE}" apply "${patch}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    faac_fail("patch application failed: ${error}")
endif()
inventory("${FAAC_STAGE}" "${output_paths}" "output")
check_hashes("${FAAC_STAGE}" "${FAAC_OUTPUT_RECORDS}" "output")
file(WRITE "${FAAC_STAGE}/provenance.json" "${provenance}")
file(RENAME "${FAAC_STAGE}" "${FAAC_BUILD_DIR}")
unset(FAAC_STAGE)
