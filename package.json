{
  "name": "lightnvr",
  "version": "1.0.0",
  "description": "LightNVR Integration Tests",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "test": "node scripts/quality/run-integration.mjs --task npm-test --project all",
    "test:api": "node scripts/quality/run-integration.mjs --task npm-api --project api --grep @api",
    "test:ui": "node scripts/quality/run-integration.mjs --task npm-ui --project ui --grep @ui",
    "test:go2rtc": "node scripts/quality/run-integration.mjs --task npm-go2rtc --project api --grep @go2rtc",
    "test:report": "npx playwright show-report",
    "test:load": "node --experimental-strip-types tests/load/index.ts",
    "test:load:api": "node --experimental-strip-types tests/load/index.ts --tags api",
    "test:load:html": "node --experimental-strip-types tests/load/index.ts --tags html",
    "test:load:heavy": "node --experimental-strip-types tests/load/index.ts -n 1000 -c 50",
    "typecheck:tests": "tsc --project tests/tsconfig.json"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
