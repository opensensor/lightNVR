{
  "name": "lightnvr-web",
  "version": "1.0.0",
  "description": "LightNVR Web Interface",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:maps": "BUILD_SOURCEMAPS=true vite build",
    "audit": "npm run build && node ../scripts/audit-touch-targets.mjs",
    "preview": "vite preview",
    "lint": "eslint js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "jest --config=jest.config.cjs",
    "test:e2e": "jest --config=jest.e2e.config.cjs --runInBand"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@preact-signals/query": "^2.1.2",
    "@preact/compat": "^18.3.2",
    "@sentry/browser": "^11.11.0",
    "@tailwindcss/postcss": "^4.3.5",
    "daisyui": "^5.7.50",
    "dayjs": "^1.11.23",
    "hls.js": "^1.7.4",
    "htm": "^3.1.1",
    "preact": "^11.1.1",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "5.34.1",
    "tailwindcss": "^4.3.5",
    "tinykeys": "^4.0.1",
    "webrtc-adapter": "^9.0.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@prefresh/vite": "^4.0.1",
    "@sentry/vite-plugin": "^11.11.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-legacy": "^8.2.4",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "selenium-webdriver": "^4.52.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-compression": "^0.5.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
