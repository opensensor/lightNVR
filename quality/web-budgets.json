  "schemaVersion": 1,
  "description": "T4 web asset budgets. Checked by `node scripts/quality/assets.mjs --check --profile <p>` (read-only). Budgets are hand-reviewed numbers; --check and --capture never write this file. Changing a budget requires measured cost, product reason, and an explicit reviewed diff (PRD ENG_01 B2).",
  "units": {
    "installed": "bytes on disk after copying web/dist (originals + shipped .gz copies + locales)",
    "served": "bytes the LightNVR static handler sends a gzip-capable browser: <file>.gz if present, else the raw file (src/web/libuv_connection.c)",
    "gzip": "zlib gzip level 9 of the original, computed by the checker",
    "raw": "uncompressed original bytes",
    "firstLoad": "HTML + initial JS (static import closure of entry scripts) + initial CSS + icon links; each file counted once",
    "transfer.unique.*": "every original file of the category counted exactly once, regardless of how many entries share it"
  },
  "policy": {
    "totals": "budget = ceil(max(baseline * 1.03, baseline + 4096)) for installed.*, transfer.*, chunks.*",
    "entries": "budget = ceil(max(baseline * 1.05, baseline + 2048)) for entries.* (per-page served bytes)",
    "rationale": "The production build is byte-for-byte reproducible (two default builds of the same tree produced identical sha256 for all 221 files), so headroom is not noise allowance. 3% / 5% admits small incidental growth from the typed-frontend migration (renamed identifiers, small helpers) while a new dependency or feature of roughly 20 KiB gzip on the main Live page (index modern initialJs served 397,094 B; 5% = 19.9 KiB) or 18 KiB served across all modern JS (3% of 604,760 B) fails the gate and forces an explicit reviewed budget change.",
    "reproduce": "node scripts/quality/assets.mjs --propose --profile <p> --from build/eng-baseline/1b8d4332/web-<p>/report.json"
  },
  "baseline": {
    "plannedRevision": "1b8d4332",
